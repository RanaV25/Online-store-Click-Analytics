<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="shoppulse.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="3117"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="cart_events" custom_title="0" dock_id="3" table="4,11:maincart_events"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">WITH category_cart_events AS (
    SELECT
        p.category,
        ce.cart_id,
        COUNT(*) AS add_to_cart_count
    FROM cart_events ce
    JOIN products p
        ON ce.product_id = p.id
    WHERE ce.event_type = 'add_to_cart'
      AND ce.cart_id IS NOT NULL
    GROUP BY p.category, ce.cart_id
),

category_add_to_cart AS (
    SELECT
        category,
        SUM(add_to_cart_count) AS add_to_cart_count,
        COUNT(DISTINCT cart_id) AS carts_with_add_to_cart
    FROM category_cart_events
    GROUP BY category
),

category_whatsapp AS (
    SELECT
        cce.category,
        COUNT(DISTINCT ce.cart_id) AS whatsapp_order_count
    FROM category_cart_events cce
    JOIN cart_events ce
        ON cce.cart_id = ce.cart_id
    WHERE ce.event_type = 'whatsapp_order_click'
    GROUP BY cce.category
)

SELECT
    atc.category,
    atc.add_to_cart_count,
    COALESCE(wa.whatsapp_order_count, 0) AS whatsapp_order_count,
    ROUND(
        100.0 * COALESCE(wa.whatsapp_order_count, 0)
        / NULLIF(atc.carts_with_add_to_cart, 0),
        2
    ) AS cart_to_whatsapp_click_ratio_pct
FROM category_add_to_cart atc
LEFT JOIN category_whatsapp wa
    ON atc.category = wa.category
ORDER BY cart_to_whatsapp_click_ratio_pct DESC;

</sql><current_tab id="0"/></tab_sql></sqlb_project>
